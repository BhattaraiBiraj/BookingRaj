<% layout("/layouts/boilerplate") %>
<div class = "row">
     <h1 class = "col-6 offset-3 mt-3">Signup on BookingRaj</h1>
<div class = "col-6 offset-3 mt-3">
    <form action = "/signup" method="Post" class="row needs-validation" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name = "username" type = "text" class="form-control" required>
            <div class="invalid-feedback">Username required</div>
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">email</label>
            <input name = "email" type = "email" class="form-control" required>
            <div class="invalid-feedback">Write valid email</div>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input name = "password" type = "Password" class="form-control" required>
            <div class="invalid-feedback">Write a good password</div>
        </div>
        <div class="mb-3">
             <button class="btn btn-success">Sign Up</button>
        </div>
    </form>
</div>
</div>