<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <h1 style="margin: 20px 0;"><%= listing.title %></h1> 

                <div class="card listing-card">
                    <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="...">
                    <div class="card-body">
                            <%= listing.description %><br><br>
                            <b>₹ <%= listing.price.toLocaleString("en-IN") %>/ Night</b><br><br>
                            <%= listing.location %>, <%= listing.country %>
                    </div>
                </div>
                <% if(currentUser && currentUser._id.equals(listing.owner._id) ) { %>
                    <div class="btns">
                            <form method="get" action="/listings/<%=listing.id%>/edit" >
                                <button class="btn edit-btn show-edit-btn">Edit</button>
                            </form>
                            <form action="/listings/<%= listing.id %>?_method=Delete" method="post">
                                <button class="btn delete-btn">Delete</button>
                            </form>
                </div>
               <% } %>
                
                
                <% if(currentUser) { %>
                    <hr>
                <div class = "review">
                    <h4>Leave a review</h4>
                    <form action="/listings/<%= listing.id %>/reviews" method="post"class="needs-validation" novalidate>
                       
                        <fieldset class="starability-fade">
                            <legend>First rating:</legend>
                            <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="rating" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="rating" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="rating" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="rating" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="rating" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        <div class = "mb-3 mt-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="comment" class= "form-control" cols = "30" rows = "5" required></textarea>
                            <div class="invalid-feedback">Comment cannot be empty!</div>
                        </div>
                        <button class ="btn btn-outline-dark mb-3">Sumbit</button>
                    </form>
                </div>
                <% } %>
                 <hr>
        </div>
         <div class="col-8 offset-2">
            <h3 class = "mb-4"> All Reviews</h3>
                <div class="row">

                    <% if(listing.reviews.length > 0){ %>
                        <% for(review of listing.reviews) { %>
                            <div class="card col-5 mb-3 ms-5">
                                <div class="card-body">
                                    <h5 class="card-title"><%= review.author.username %></h5>
                                    <p class="card-text"><%= review.rating %> Star</p>
  <p class="starability-result" data-rating=<%= review.rating %>></p>
                                    <p class="card-text"><%= review.comment %></p>
                                     <% if(currentUser && currentUser._id.equals(review.author._id) ) { %>
                                    <form action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=Delete" method="post">
                                        <button class="btn btn-dark">Delete</button>
                                    </form>
                                     <%}%>
                                </div>
                            </div>
                        <% } %> 
                   <% } else { %>
                        <p style="color: rgb(37, 37, 37);" class="mb-5">There is no review yet</p>
                   <% } %>
                        
                </div>
                </div>
    </div>  
</body>
