<% layout("/layouts/boilerplate") %>

<style>
    #filters{
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter{
        font-size: 12px;
        text-align: center;
        margin-right : 2rem;
        margin-top: 2rem;
        opacity: 0.7;
    }
    .filter:hover{
        opacity: 1;
        cursor: pointer;
    }

    .tax-toggle{
        border: 1px solid black;
        border-radius: 20px;
        height : 3rem;
        padding: 1rem;
        display: flex;
        align-items: center;
    }

    .tax-info{
        display: none;
    }

    .tax-toggle div input,label:hover{
        cursor: pointer;
    }
</style>
<body>
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Room</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castle</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
           <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
            </div>   
    </div>
         <% if (allListings.length > 0) { %>
            <h1 style="margin: 20px 0;">All listings</h1>
        <% } %>
    
        <% if (allListings.length === 0) { %>
            <h1 style="margin-top: 30px;">OOPS !</h1>
            <p style="margin-top: 30px; color: #fe424d;">No listings found for "<%= searchQuery %>". Try another city!</p>
        <% } %>
         <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2">   
        <% for(listing of allListings) { %>
            <a href="http://localhost:8080/listings/<%= listing.id %>" class="listing-link"> 
            <div class="card listing-card">
                    <img src="<%=listing.image.url%>" class="card-img-top" alt="img of place">
                    <div class="card-img-overlay"></div>
                    
                    <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %><br></b>
                        ₹ <%= listing.price.toLocaleString("en-IN") %> /Night &nbsp;&nbsp;&nbsp;&nbsp; 
                        <i class="tax-info">+13% GST</i><br>
                        
                    </p>
                    </div>
            </div>
            </a>
        <% } %>
     </div> 

     <script>
        const taxToggle = document.querySelector("#switchCheckDefault");
        const taxInfo= document.querySelectorAll(".tax-info");

        taxToggle.addEventListener("click", ()=>{
            for(info of taxInfo){
                if(info.style.display != "inline"){
                    info.style.display = "inline";
                } 
                else{
                    info.style.display = "none";
                }
            }
               
        })
     </script>
</body>