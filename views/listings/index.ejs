<% layout("/layouts/boilerplate") %>
<body>
    <h1 style="margin: 20px 0;">All listings</h1>
    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2">
        <% for(listing of allListings) { %>
            <a href="http://localhost:8080/listings/<%= listing.id %>" class="listing-link"> 
            <div class="card">
                    <img src="<%=listing.image%>" class="card-img-top" alt="img of place">
                    <div class="card-img-overlay"></div>
                    
                    <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %><br></b>
                        ₹ <%= listing.price.toLocaleString("en-IN") %> /Night<br>
                        <%= listing.location %>
                    </p>
                    </div>
            </div>
            </a>
        <% } %>
     </div> 
</body>